// Sample Data
const tasks = [
    { start: 1, end: 3 },
    { start: 2, end: 5 },
    { start: 4, end: 6 },
    { start: 6, end: 7 },
    { start: 5, end: 9 },
    { start: 8, end: 10 }
];

/**
 * Brute-Force Approach
 * Generates all possible subsets (2^n) and finds the largest valid set of non-overlapping tasks.
 * Time Complexity: O(2^n)
 */
function maxTasksBruteForce(tasks) {
    let maxSubset = [];

  // Helper to generate power set recursively
    function generateSubsets(index, currentSet) {
        if (index === tasks.length) {
        if (isValid(currentSet) && currentSet.length > maxSubset.length) {
            maxSubset = [...currentSet];
        }
        return;
    }
    // Exclude current task
    generateSubsets(index + 1, currentSet);
    // Include current task
    generateSubsets(index + 1, [...currentSet, tasks[index]]);
    }

  // Helper to check if a task subset has overlaps
    function isValid(set) {
        const sorted = [...set].sort((a, b) => a.start - b.start);
        for (let i = 0; i < sorted.length - 1; i++) {
            if (sorted[i].end > sorted[i + 1].start) {
                return false; // Overlap detected
            }
    }
    return true;
    }

    generateSubsets(0, []);
    return maxSubset;
}

/**
 * Greedy Approach (Earliest Finish Time First)
 * Sorts tasks by end time and greedily selects non-overlapping tasks.
 * Time Complexity: O(n log n)
 */
function maxTasksGreedy(tasks) {
    if (!tasks.length) return [];

  // Sort by finish time ascending
    const sortedTasks = [...tasks].sort((a, b) => a.end - b.end);
    
    const result = [sortedTasks[0]];
    let lastEndTime = sortedTasks[0].end;

    for (let i = 1; i < sortedTasks.length; i++) {
    if (sortedTasks[i].start >= lastEndTime) {
        result.push(sortedTasks[i]);
        lastEndTime = sortedTasks[i].end;
    }
    }

    return result;
}

// Validation on sample input
console.log("Brute-Force Result:", maxTasksBruteForce(tasks));
// Output count: 4 tasks -> [{1,3}, {4,6}, {6,7}, {8,10}]
console.log("Greedy Result:", maxTasksGreedy(tasks));
// Output count: 4 tasks -> [{1,3}, {4,6}, {6,7}, {8,10}]


// Helper to generate mock data
function generateRandomTasks(count) {
    const data = [];
    for (let i = 0; i < count; i++) {
    const start = Math.floor(Math.random() * 100000);
    const duration = Math.floor(Math.random() * 50) + 1;
    data.push({ start, end: start + duration });
}
    return data;
}

// Test with large input
const largeTasks = generateRandomTasks(10000);

// Benchmark Greedy
console.time("Greedy (10,000 tasks)");
const greedyOutput = maxTasksGreedy(largeTasks);
console.timeEnd("Greedy (10,000 tasks)");

// Benchmark Brute-Force (Capped at 20 elements to avoid crashing Node.js runtime)
const smallTasks = generateRandomTasks(20);

console.time("Brute-Force (20 tasks)");
const bruteOutput = maxTasksBruteForce(smallTasks);
console.timeEnd("Brute-Force (20 tasks)");



/*
Greedy is faster for large inputes because it sorts the tasks and then iterates through them once, resulting in O(n log n) time complexity. 
The brute-force approach generates all possible subsets of tasks, leading to exponential time complexity O(2^n), which becomes not doable for larger inputs.

2- Greedy is easier to scale and maintain

3-The memory trade offs on the greedy are minimal compared to the exponential space complexity of the brute-force approach.


4- I choose greedy because it is more efficient, scalable, and easier to maintain. It provides optimal solutions for the task scheduling problem in little time, while the brute force approach could be used for small inputs or for educational purposes to understand the problem better.

*/